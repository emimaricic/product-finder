PORT=3000
DATABASE_URL=postgresql://finder:finder@localhost:5434/product_finder?schema=public

# Optional. Only needed if the frontend is served from a different origin.
# CORS_ORIGINS=http://localhost:4200

# Number of reverse proxies in front of the API (nginx in Docker = 1).
# TRUST_PROXY=1

RATE_LIMIT_TTL_MS=60000
# Reads are generous: phones at a trade-fair booth share one public IP (NAT).
RATE_LIMIT_MAX=600

# Path to the PIM export used by `npm run db:seed` (default ../data/products.csv)
# CATALOGUE_CSV_PATH=../data/products.csv

# Anonymous review submissions per IP per window (spam brake, no auth).
REVIEW_RATE_LIMIT_TTL_MS=600000
REVIEW_RATE_LIMIT_MAX=5
